# Copy this file to .env and fill in real values before running in production.

PORT=4000

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API.
# Use * only for quick local testing — never in production.
CORS_ORIGIN=*

# Credentials for the one seeded admin account (created on first run only).
ADMIN_EMAIL=admin@sih.gov.in
ADMIN_PASSWORD=admin123
